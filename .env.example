# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored. Never commit a real key.

# Required: API key for an OpenAI-compatible endpoint.
OPENAI_API_KEY=

# Optional: base URL of the OpenAI-compatible endpoint.
# Leave empty for api.openai.com. For a course proxy (e.g. Vocareum), use the
# base URL given by your course, for example https://openai.vocareum.com/v1
OPENAI_BASE_URL=

# Optional: model name (default gpt-4o-mini). The model must support tool calling.
OPENAI_MODEL=gpt-4o-mini
